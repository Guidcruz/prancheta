{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push --delete *)",
      "Bash(git branch -D main*)",
      "Bash(git branch -d main*)",
      "Bash(git reset --hard *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push --delete *)",
      "PowerShell(git branch -D main*)",
      "PowerShell(git branch -d main*)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git tag *)",
      "PowerShell(gh release *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh repo delete *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git merge --no-ff quick/*)",
      "PowerShell(git merge --no-ff quick/*)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item *)",
      "Bash(docker push *)",
      "Bash(npm publish*)",
      "Bash(npx wrangler *)",
      "Bash(wrangler *)",
      "Bash(curl *)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(dotnet add package *)",
      "Bash(cargo add *)",
      "PowerShell(dotnet add package *)",
      "PowerShell(cargo add *)",
      "PowerShell(npm install *)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",
      "Bash(git worktree list*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)",
      "PowerShell(git branch*)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git fetch*)",
      "PowerShell(git pull*)",
      "PowerShell(git stash*)",
      "PowerShell(git worktree list*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx vitest*)",
      "Bash(npx jest*)",
      "Bash(npx playwright test*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(npx tsc*)",
      "Bash(pnpm run *)",
      "Bash(pnpm test*)",
      "Bash(yarn test*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(ruff *)",
      "Bash(black *)",
      "Bash(mypy *)",
      "Bash(dotnet test*)",
      "Bash(dotnet build*)",
      "Bash(dotnet format*)",
      "PowerShell(dotnet test*)",
      "PowerShell(dotnet build*)",
      "PowerShell(dotnet format*)",
      "Bash(cargo test*)",
      "Bash(cargo build*)",
      "Bash(cargo clippy*)",
      "Bash(cargo fmt*)",
      "PowerShell(cargo test*)",
      "PowerShell(cargo build*)",
      "PowerShell(cargo clippy*)",
      "PowerShell(cargo fmt*)",
      "Bash(go test*)",
      "Bash(go build*)",
      "Bash(go vet*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(npm run build*)",
      "Bash(npm run tokens*)",
      "Bash(npm run balance*)",
      "Bash(npm run content:check*)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run test:all*)",
      "Bash(npm run dev*)",
      "Bash(npm ci*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh run list*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\""
          }
        ]
      }
    ]
  }
}
