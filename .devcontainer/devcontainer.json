{
  "name": "Prancheta",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "containerEnv": {
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "postCreateCommand": "bash -lc '. \"${NVM_DIR:-/usr/local/share/nvm}/nvm.sh\" && nvm install \"$(cat .nvmrc)\" && nvm alias default \"$(cat .nvmrc)\" && nvm use default && node -v && npm ci'",
  "forwardPorts": [5173, 4321],
  "portsAttributes": {
    "5173": { "label": "Jogo (app)" },
    "4321": { "label": "Site" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer"
      ]
    }
  }
}
