---
import { config } from '../../../config/prancheta.config.ts';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '../../../app/src/tokens.css';
import '../theme-auto.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {
  title?: string;
  description?: string;
  /** Menu entry to mark as the current page (see lib/nav.ts). */
  current?: string;
  /** Open Graph type; posts use "article". */
  ogType?: 'website' | 'article';
  /** Wide pages (grids) use the wide column. */
  wide?: boolean;
}
const {
  title,
  description = config.slogan['pt-BR'],
  current,
  ogType = 'website',
  wide = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${config.name}` : config.name;
const base = config.paths.site;
const canonical = new URL(Astro.url.pathname, `https://${config.domain}`).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={config.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="theme-color"
      content={config.colors.background}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${config.paths.game}/icons/icon.svg`} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Devlog · ${config.name}`}
      href={`${base}devlog/rss.xml`}
    />
  </head>
  <body>
    <a class="skip rotulo" href="#conteudo">
      Pular para o conteúdo
    </a>
    <SiteHeader {current} />
    <main id="conteudo" class:list={{ wide }}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    background: var(--surface-0);
    color: var(--ink);
    font: var(--type-body);
  }
  main {
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
  }
  main.wide {
    max-width: var(--layout-wide-max);
  }
  main.wide > * {
    max-width: var(--layout-wide-max);
  }
  a {
    color: var(--info);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.botao,
  nav a,
  .links a {
    text-decoration: none;
  }
  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -100px;
    z-index: 20;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-1);
    color: var(--ink);
    border-radius: var(--radius-md);
    min-height: var(--touch);
  }
  .skip:focus {
    top: var(--space-2);
  }
  h1 {
    font: var(--type-display-xl);
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
    hyphens: auto;
    overflow-wrap: break-word;
  }
  h2 {
    font: var(--type-titulo);
    margin: var(--space-8) 0 var(--space-3);
  }
  h3 {
    font: var(--type-subtitulo);
    margin: var(--space-6) 0 var(--space-2);
  }
  p,
  ul,
  ol {
    margin-top: 0;
  }
  .card {
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    font: var(--type-rotulo);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  td.numero {
    font-variant-numeric: tabular-nums;
  }
  code {
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    font-size: 14px;
  }
  img {
    max-width: 100%;
    border-radius: var(--radius-md);
  }
  .muted {
    color: var(--ink-muted);
  }
  .lead {
    font: var(--type-subtitulo);
    color: var(--ink-muted);
  }
  .grid-cards {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-cards.three {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
