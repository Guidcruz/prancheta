---
import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { config } from '../../../config/prancheta.config.ts';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '../../../app/src/tokens.css';
import '../theme-auto.css';
import tokens from '../../../design/tokens.json';
import { shareFor } from '../data/share';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {
  title?: string;
  /** Overrides the description of the share entry (devlog posts use their own summary). */
  description?: string;
  /** Key of the entry in data/share.ts: sets the description and the share image. */
  share?: string;
  /** Menu entry to mark as the current page (see lib/nav.ts). */
  current?: string;
  /** Open Graph type; posts use "article". */
  ogType?: 'website' | 'article';
}
const { title, share, current, ogType = 'website' } = Astro.props;
const entry = share ? shareFor(share) : undefined;
const description = Astro.props.description ?? entry?.description ?? config.slogan['pt-BR'];
const fullTitle = title ? `${title} · ${config.name}` : config.name;
const base = config.paths.site;
const lightBg = String(
  tokens.color.tokens.find((t) => t.name === 'surface-0')?.value.dia ?? config.colors.background,
);
const canonical = new URL(Astro.url.pathname, `https://${config.domain}`).href;
// The share image is generated before the build (scripts/og.mjs); without the file, no tags.
const ogPath = entry ? `${base}og/${entry.file}` : undefined;
// Walk up from this file to the folder with astro.config.mjs (works in dev and in the bundled
// build, where import.meta.url points to a chunk).
let siteRoot = dirname(fileURLToPath(import.meta.url));
while (
  !['astro.config.mjs', 'astro.config.ts'].some((f) => existsSync(join(siteRoot, f))) &&
  dirname(siteRoot) !== siteRoot
)
  siteRoot = dirname(siteRoot);
const hasImage = ogPath !== undefined && existsSync(join(siteRoot, 'public/og', entry?.file ?? ''));
const ogImage = hasImage && ogPath ? new URL(ogPath, `https://${config.domain}`).href : undefined;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={config.name} />
    <meta name="twitter:card" content="summary_large_image" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={entry?.ogTitle} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta
      name="theme-color"
      content={config.colors.background}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="theme-color" content={lightBg} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={`${config.paths.game}/icons/icon.svg`} type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Devlog · ${config.name}`}
      href={`${base}devlog/rss.xml`}
    />
  </head>
  <body>
    <a class="skip rotulo" href="#conteudo">
      Pular para o conteúdo
    </a>
    <SiteHeader {current} />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
  body {
    margin: 0;
    background: var(--surface-0);
    color: var(--ink);
    font: var(--type-body);
    overflow-x: clip;
  }
  svg {
    display: block;
  }
  a {
    color: var(--info);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a.botao {
    text-decoration: none;
  }
  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: var(--space-2);
    top: -100px;
    z-index: 50;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-1);
    color: var(--ink);
    border-radius: var(--radius-md);
    min-height: var(--touch);
  }
  .skip:focus {
    top: var(--space-2);
  }
  h1,
  h2 {
    font: var(--type-display-lg);
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  h3 {
    font: var(--type-subtitulo);
    margin: var(--space-6) 0 var(--space-2);
  }
  p,
  ul,
  ol {
    margin-top: 0;
  }
  /* Page sections: reading column by default, wide for grids. */
  .sec {
    position: relative;
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 48px var(--space-4);
    font: var(--type-body-lg);
  }
  .sec.wide {
    max-width: var(--layout-wide-max);
  }
  .sec h2:not(:first-child) {
    margin-top: var(--space-8);
  }
  .sec.wide > :where(p, ul:not([class]), ol:not([class])) {
    max-width: var(--layout-content-max);
  }
  .page-hero + .sec {
    padding-top: var(--space-4);
  }
  /* Inner pages: sections follow each other without doubling the padding. */
  .sec.flow + .sec.flow {
    padding-top: 0;
  }
  .sec :where(ul:not([class]), ol:not([class])) {
    padding-left: var(--space-6);
  }
  /* Soft green glow behind glass cards (derivation allowed in docs/design/site.md). */
  .glow {
    isolation: isolate;
  }
  .glow::before {
    content: '';
    position: absolute;
    inset: 10% 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in srgb, var(--grass) 15%, transparent),
      transparent 70%
    );
  }
  .card {
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  table {
    border-collapse: collapse;
    width: 100%;
  }
  th,
  td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    font: var(--type-rotulo);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  td.numero {
    font-variant-numeric: tabular-nums;
  }
  code {
    background: var(--surface-2);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    font-size: 14px;
  }
  img {
    max-width: 100%;
    border-radius: var(--radius-md);
  }
  .muted {
    color: var(--ink-muted);
  }
  .link {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .grid-cards {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .sec {
      padding: 72px var(--space-8);
    }
    .grid-cards {
      grid-template-columns: repeat(2, 1fr);
    }
    .grid-cards.three {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
