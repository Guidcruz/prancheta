---
import Base from '../layouts/Base.astro';
import { config } from '../../../config/prancheta.config.ts';
import { getCollection } from 'astro:content';
import FeatureCard from '../components/FeatureCard.astro';
import StepList from '../components/StepList.astro';
import StadiumHero from '../components/StadiumHero.astro';
import ClubShield from '../components/ClubShield.astro';
import StageTable from '../components/StageTable.astro';
import PostCard from '../components/PostCard.astro';
import FinalCta from '../components/FinalCta.astro';
import { clubsById, exampleClubIds } from '../lib/shields';
import { stages } from '../lib/roadmap';

const posts = (await getCollection('devlog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const base = config.paths.site;
const clubs = clubsById(exampleClubIds);
const miniClubs = clubsById(['botafogueira', 'corinto', 'palmeral', 'coritibom']);
---

<Base share="index">
  <StadiumHero
    title={config.name}
    tag="Em desenvolvimento · acompanhe no devlog"
    slogan={config.slogan['pt-BR']}
    sloganHighlight={config.slogan.short['pt-BR']}
    lead="Você é o técnico. Escala o time, mexe na tática, grita da beira do campo e encara a tabela. Tudo no celular, em rodadas de poucos minutos."
    note={`O ${config.name} está em desenvolvimento. A versão que você abre hoje ainda é bem pequena: uma tela e um botão. Ela cresce toda semana, e você acompanha tudo no devlog.`}
    primary={{
      href: `${config.paths.game}/`,
      label: `Abrir a versão atual (v${config.version})`,
    }}
    secondary={{ href: `${base}roadmap/`, label: 'Ver o roteiro' }}
    {clubs}
  />

  <section class="sec wide what" aria-labelledby="oque">
    <div>
      <h2 id="oque">O que é</h2>
    </div>
    <div class="text">
      <p>
        O {config.name} é um jogo de técnico de futebol para jogar no navegador e instalar no
        celular, como um app.
      </p>
      <p>
        Os clubes são todos fictícios, com nomes em trocadilho: você reconhece o seu time pela
        cidade, pelas cores e pela torcida, sem nenhuma marca oficial.
      </p>
      <p>
        Não precisa de cadastro. Não tem pegadinha. Tem rodada, tabela e aquele frio na barriga de
        domingo.
      </p>
    </div>
  </section>

  <section class="sec wide glow" aria-labelledby="destaques">
    <h2 id="destaques">Destaques</h2>
    <ul class="grid-cards four">
      <li>
        <FeatureCard
          title="Rodadas de poucos minutos"
          icon="phone"
          recurso="rodadas-curtas"
          href={`${base}o-jogo/`}
          linkLabel="Conhecer o jogo"
          interactive
        >
          <p>Escale, ajuste a tática e jogue uma rodada no tempo de uma viagem de ônibus.</p>
        </FeatureCard>
      </li>
      <li>
        <FeatureCard
          title="Carreira sem internet"
          icon="offline"
          recurso="carreira-offline"
          href={`${base}modos/`}
          linkLabel="Ver os modos de jogo"
          interactive
        >
          <p>Sua carreira fica no seu aparelho e funciona offline.</p>
        </FeatureCard>
      </li>
      <li>
        <FeatureCard
          title="Liga com os amigos"
          icon="users"
          recurso="liga-amigos"
          showStage
          href={`${base}modos/`}
          linkLabel="Ver os modos de jogo"
          interactive
        >
          <p>Cada um com um clube, no mesmo campeonato, por código de convite.</p>
        </FeatureCard>
      </li>
      <li>
        <FeatureCard
          title="Clubes com cara de Brasil"
          icon="shield"
          recurso="clubes-ficticios"
          href={`${base}clubes/`}
          linkLabel="Ver os clubes"
          interactive
        >
          <p>
            Flamingo, Corinto, Coritibom e mais: clubes fictícios que a gente reconhece de longe.
          </p>
          <div class="mini" aria-hidden="true">
            {miniClubs.map((club) => (
              <ClubShield {club} size={30} decorative />
            ))}
          </div>
        </FeatureCard>
      </li>
    </ul>
  </section>

  <div class="sec wide duo">
    <section aria-labelledby="comecar">
      <h2 id="comecar">Como começar</h2>
      <StepList
        steps={[
          { title: 'Abra o jogo.', text: 'Use o botão acima, no celular.' },
          {
            title: 'Instale na tela inicial.',
            text: `No Android, pelo menu do Chrome (⋮) → "Instalar app". No iPhone (iOS), pelo botão de compartilhar do Safari → "Adicionar à Tela de Início".`,
          },
          { title: 'Escolha um clube.', text: 'E jogue a primeira rodada.' },
        ]}
      />
      <p class="caption small">
        Hoje o passo 3 ainda não existe: a escolha de clube e as rodadas estão sendo construídas.
        Veja o estado de cada coisa no <a href={`${base}roadmap/`}>roteiro</a>.
      </p>
    </section>
    <section aria-labelledby="onde">
      <h2 id="onde">Onde estamos</h2>
      <StageTable {stages} variant="compact" />
      <p>
        <a class="link" href={`${base}roadmap/`}>
          Ver o roteiro completo
        </a>
      </p>
    </section>
  </div>

  <section class="sec wide" aria-labelledby="jeito">
    <h2 id="jeito">Jeito de fazer</h2>
    <ul class="way">
      <li>
        <h3>Sem pagar para ganhar.</h3>
        <p>Nunca. Sem caixa de sorteio, sem recompensa por tempo de uso.</p>
      </li>
      <li>
        <h3>Seus dados são seus.</h3>
        <p>O modo offline não pede cadastro, e nada sai do seu aparelho.</p>
      </li>
      <li>
        <h3>Dá para acompanhar.</h3>
        <p>Um post por semana no devlog, com o que foi feito e o que vem a seguir.</p>
      </li>
    </ul>
  </section>

  <section class="sec wide" aria-labelledby="ultimas">
    <h2 id="ultimas">Últimas do devlog</h2>
    <ul class="grid-cards three">
      {posts.map((p) => (
        <li>
          <PostCard post={p} />
        </li>
      ))}
    </ul>
    <p>
      <a class="link" href={`${base}devlog/`}>
        Todos os posts
      </a>
    </p>
  </section>

  <FinalCta />

  <section class="sec closing">
    <p>
      Quer acompanhar? Leia o <a href={`${base}devlog/`}>devlog</a>, veja o{' '}
      <a href={`${base}roadmap/`}>roteiro</a> e tire dúvidas nas{' '}
      <a href={`${base}perguntas/`}>perguntas frequentes</a>.
    </p>
    <p>
      Quer ajudar o projeto a seguir de pé? Veja como <a href={`${base}apoiar/`}>apoiar</a>.
    </p>
  </section>
</Base>
<style>
  .what {
    display: grid;
    gap: 0;
  }
  .what h2 {
    margin-bottom: var(--space-4);
  }
  .text p {
    max-width: 60ch;
    margin: 0 0 var(--space-3);
  }
  .text p:first-child {
    font: var(--type-subtitulo);
    font-size: 24px;
    line-height: 30px;
    color: var(--ink);
  }
  .grid-cards.four {
    isolation: isolate;
  }
  .mini {
    display: flex;
    gap: 6px;
    margin-top: var(--space-1);
  }
  .duo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .small {
    margin: var(--space-4) 0 0;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-muted);
  }
  .way {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .way li {
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--surface-1), var(--surface-0));
  }
  .way h3 {
    margin: 0 0 var(--space-1);
    text-transform: uppercase;
  }
  .way p {
    margin: 0;
    color: var(--ink-muted);
  }
  .closing {
    color: var(--ink-muted);
    padding-block: var(--space-8) var(--space-4);
  }
  @media (min-width: 600px) {
    .grid-cards.four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 720px) {
    .what {
      grid-template-columns: 5fr 7fr;
      gap: 48px;
      align-items: start;
    }
    .duo {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px;
    }
    .way {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 960px) {
    .grid-cards.four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
