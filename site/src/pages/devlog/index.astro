---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('devlog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Devlog" current="devlog" share="devlog">
  <PageHero
    title="Devlog"
    lead="Um post por semana, mesmo que curto, e um por etapa concluída. Desde o dia 1."
  />
  <section class="sec flow" aria-label="Posts">
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <PostCard post={p} />
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .posts {
    display: grid;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
