---
import Base from '../../layouts/Base.astro';
import { config } from '../../../../config/prancheta.config.ts';
import { getCollection } from 'astro:content';
const posts = (await getCollection('devlog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const base = config.paths.site;
---

<Base title="Devlog" description={`Diário de desenvolvimento do ${config.name}, desde o dia 1.`}>
  <h1>Devlog</h1>
  <p>Um post por semana, mesmo que curto, e um por etapa concluída. Desde o dia 1.</p>
  {posts.map((p) => (
    <article class="card" style="margin-bottom: var(--space-3)">
      <p class="caption" style="color: var(--ink-muted); margin: 0">
        {p.data.date.toLocaleDateString('pt-BR', { timeZone: 'UTC' })} · Etapa {p.data.etapa}
        {p.data.tags.length ? ' · ' + p.data.tags.join(', ') : ''}
      </p>
      <h3 style="margin-top: var(--space-1)">
        <a href={`${base}devlog/${p.id}/`}>{p.data.title}</a>
      </h3>
      <p style="margin: 0">{p.data.summary}</p>
    </article>
  ))}
</Base>
