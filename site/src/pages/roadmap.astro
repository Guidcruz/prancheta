---
import Base from '../layouts/Base.astro';
import StageTable from '../components/StageTable.astro';
import { stages, roadmapNote } from '../lib/roadmap';
// Single source: docs/roadmap.md (the table). Changed there, changed here on the next build.
---

<Base
  title="Roteiro"
  current="roadmap"
  description="As etapas do jogo, cada uma com uma versão jogável."
  wide
>
  <h1>Roteiro</h1>
  <p>Cada etapa termina com uma versão jogável, publicada aqui. {roadmapNote}</p>
  <StageTable stages={stages} />
</Base>
