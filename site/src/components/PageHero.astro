---
interface Props {
  title: string;
  lead?: string;
  /** Small line above the title (devlog posts: date and stage). */
  kicker?: string;
}
const { title, lead, kicker } = Astro.props;
---

<header class="page-hero">
  <div class="inner">
    {kicker && <p class="rotulo kicker">{kicker}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
<style>
  /* Contained version of the hero: the two corner beams only, no stripes and no towers. */
  .page-hero {
    position: relative;
    isolation: isolate;
    padding: var(--space-8) 0 var(--space-6);
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 80% at 0% 0%, var(--beam), transparent 70%),
      radial-gradient(60% 80% at 100% 0%, var(--beam), transparent 70%);
  }
  .inner {
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  .kicker {
    margin: 0 0 var(--space-2);
  }
  h1 {
    margin: 0;
  }
  .inner :global(.lead) {
    margin: var(--space-3) 0 0;
    font: var(--type-body-lg);
  }
  @media (min-width: 720px) {
    .inner {
      padding: 0 var(--space-8);
    }
  }
</style>
