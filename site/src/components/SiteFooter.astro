---
import { config } from '../../../config/prancheta.config.ts';
const base = config.paths.site;
const { supportEmail, discussionsUrl } = config.contacts;
---

<footer class="foot">
  <div class="inner caption">
    <div>
      <p>
        O nome {config.name} é provisório, até a conferência de marca. Clubes, jogadores e marcas do
        jogo são fictícios.
      </p>
      <p class="ver rotulo">Versão {config.version}</p>
    </div>
    <ul class="links">
      <li>
        <a href={`${base}privacidade/`}>Privacidade</a>
      </li>
      <li>
        <a href={`${base}apoiar/`}>Apoiar</a>
      </li>
      <li>
        <a href={`${base}roadmap/`}>Roteiro</a>
      </li>
      <li>
        <a href={`${base}devlog/`}>Devlog</a>
      </li>
      {discussionsUrl && (
        <li>
          <a href={discussionsUrl}>Discussões (GitHub, público)</a>
        </li>
      )}
      <li class="apart">
        <a href={`${base}devlog/rss.xml`}>RSS do devlog</a>
      </li>
    </ul>
    {supportEmail && (
      <p>
        Contato: <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
      </p>
    )}
  </div>
</footer>
<style>
  .foot {
    background: var(--surface-0);
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
  }
  .inner {
    max-width: var(--layout-wide-max);
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-8);
    display: grid;
    gap: var(--space-4);
  }
  p {
    margin: 0 0 var(--space-1);
  }
  .ver {
    font-variant-numeric: tabular-nums;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    min-width: var(--touch);
    padding: var(--space-1) 0;
    color: var(--ink);
  }
  .apart {
    margin-left: auto;
  }
  @media (min-width: 720px) {
    .inner {
      grid-template-columns: 2fr 3fr;
      gap: var(--space-8);
      padding: var(--space-8) var(--space-8) 48px;
      align-items: start;
    }
  }
</style>
