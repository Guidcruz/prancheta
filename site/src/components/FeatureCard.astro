---
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';
import GlassCard from './GlassCard.astro';
import type { FeatureStatus } from '../lib/roadmap';
interface Props {
  title: string;
  icon?: 'phone' | 'offline' | 'users' | 'shield' | 'ball' | 'gear';
  recurso?: string;
  status?: FeatureStatus;
  showStage?: boolean;
  href?: string;
  linkLabel?: string;
  /** Glass over a decorated background (default) or a plain surface-1 card. */
  glass?: boolean;
  /** Glass cards: hover and focus change the border and lift the card. */
  interactive?: boolean;
}
const {
  title,
  icon,
  recurso,
  status,
  showStage,
  href,
  linkLabel,
  glass = true,
  interactive = false,
} = Astro.props;
---

<GlassCard as="article" {interactive} solid={!glass}>
  <div class="top">
    {icon && (
      <span class="ic">
        <Icon name={icon} size={26} />
      </span>
    )}
    <StatusBadge {recurso} {status} {showStage} />
  </div>
  <h3 class="subtitulo">{title}</h3>
  <div class="body">
    <slot />
  </div>
  {href && (
    <a class="more" {href}>
      {linkLabel ?? 'Saiba mais'}
    </a>
  )}
</GlassCard>
<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .ic {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--grass-soft);
    color: var(--ink);
  }
  h3 {
    margin: var(--space-1) 0 0;
    text-transform: uppercase;
  }
  .body {
    flex: 1;
    color: var(--ink-muted);
  }
  .body :global(p),
  .body :global(ul) {
    margin: 0 0 var(--space-2);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    margin-top: auto;
  }
</style>
