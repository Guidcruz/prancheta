---
import StatusBadge from './StatusBadge.astro';
import Icon from './Icon.astro';
import type { FeatureStatus } from '../lib/roadmap';
interface Props {
  title: string;
  icon?: 'phone' | 'offline' | 'users' | 'shield' | 'ball' | 'gear';
  status?: FeatureStatus;
  stage?: string;
  showStage?: boolean;
  href?: string;
  linkLabel?: string;
}
const { title, icon, status, stage, showStage, href, linkLabel } = Astro.props;
---

<article class="card">
  <div class="top">
    {icon && <Icon name={icon} size={24} />}
    <StatusBadge {status} {stage} {showStage} />
  </div>
  <h3 class="subtitulo">{title}</h3>
  <div class="body">
    <slot />
  </div>
  {href && (
    <a class="more" {href}>
      {linkLabel ?? 'Saiba mais'}
    </a>
  )}
</article>
<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    padding: var(--space-4);
    height: 100%;
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    color: var(--grass);
  }
  h3 {
    margin: 0;
  }
  .body {
    flex: 1;
  }
  .body :global(p),
  .body :global(ul) {
    margin: 0 0 var(--space-2);
  }
  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
  }
</style>
