---
import StatusBadge from './StatusBadge.astro';
import TableScroll from './TableScroll.astro';
import type { Stage } from '../lib/roadmap';
import { stageSummaries } from '../data/etapas-resumo';
interface Props {
  stages: Stage[];
  /** `compact`: Etapa, Nome, Estado (home). `full`: adds "O que entra" (roadmap and modes). */
  variant?: 'compact' | 'full';
  /** 'delivery' shows the roadmap text; 'summary' the short text from data/etapas-resumo.ts. */
  text?: 'delivery' | 'summary';
}
const { stages, variant = 'full', text = 'delivery' } = Astro.props;
const full = variant === 'full';
---

<TableScroll label="Etapas do jogo" minWidth={full ? '640px' : '0px'}>
  <table class:list={['stages', variant]}>
    <thead>
      <tr>
        <th scope="col" class="et">
          Etapa
        </th>
        <th scope="col">Nome</th>
        {full && (
          <th scope="col" aria-label="O que entra para o jogador">
            O que entra
          </th>
        )}
        <th scope="col" class="state">
          Estado
        </th>
      </tr>
    </thead>
    <tbody>
      {stages.map((s) => {
        const current = s.status === 'em-desenvolvimento';
        return (
          <tr
            class:list={{ current, done: s.status === 'disponivel' }}
            aria-current={current ? 'step' : undefined}
          >
            <th scope="row" class="et">
              {s.id}
            </th>
            <td class="name body-strong">{s.name}</td>
            {full && (
              <td class="what">{text === 'summary' ? (stageSummaries[s.id] ?? '') : s.delivery}</td>
            )}
            <td class="state">
              <StatusBadge status={s.status} />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</TableScroll>
<style>
  table.stages {
    width: 100%;
  }
  table.stages th.et {
    width: 52px;
    font: 800 26px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-muted);
  }
  table.stages thead th.et {
    font: var(--type-rotulo);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  table.stages tbody tr.current > th.et,
  table.stages tbody tr.done > th.et {
    color: var(--ink);
  }
  table.stages tbody tr.current > th.et {
    box-shadow: inset 4px 0 0 var(--grass);
  }
  table.stages tbody tr.current {
    background: var(--grass-soft);
  }
  .name {
    min-width: 0;
    overflow-wrap: anywhere;
    color: var(--ink);
  }
  .what {
    min-width: 220px;
    color: var(--ink-muted);
  }
  .state {
    width: 1%;
    white-space: nowrap;
  }
</style>
