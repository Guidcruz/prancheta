---
import Icon from './Icon.astro';
import { getRecurso, statusForRecurso } from '../data/recursos';
import type { FeatureStatus } from '../lib/roadmap';
interface Props {
  /** Resource id in data/recursos.ts; status and stage come from there. */
  recurso?: string;
  /** Explicit status, for stage rows (StageTable, StageStrip). */
  status?: FeatureStatus;
  /** Show "Etapa X" in the label (needs `recurso`). */
  showStage?: boolean;
}
const { recurso, showStage = false } = Astro.props;
const status: FeatureStatus =
  Astro.props.status ?? (recurso ? statusForRecurso(recurso) : 'planejado');
const labels: Record<FeatureStatus, string> = {
  disponivel: 'Disponível',
  'em-desenvolvimento': 'Em desenvolvimento',
  planejado: 'Planejado',
};
const icons = { disponivel: 'check', 'em-desenvolvimento': 'gear', planejado: 'calendar' } as const;
const label =
  labels[status] + (showStage && recurso ? ` · Etapa ${getRecurso(recurso).stage}` : '');
---

<span class:list={['badge', 'rotulo', status]}>
  <Icon name={icons[status]} size={14} />
  {label}
</span>
<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: 24px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    white-space: nowrap;
    vertical-align: middle;
  }
  .disponivel {
    background: var(--grass-soft);
    color: var(--ink);
  }
  .em-desenvolvimento {
    background: var(--floodlight);
    color: var(--on-floodlight);
  }
  .planejado {
    background: var(--surface-2);
    color: var(--ink);
    border: 1px dashed var(--ink-muted);
  }
</style>
