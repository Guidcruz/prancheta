---
import { config } from '../../../config/prancheta.config.ts';
import { navItems } from '../lib/nav';
import Icon from './Icon.astro';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const base = config.paths.site;
---

<header class="top">
  <div class="bar">
    <a class="brand" href={base}>
      {config.logo.hasBrand && <span class="mark" set:html={config.logo.mark} />}
      <span class="subtitulo">{config.name}</span>
    </a>
    <nav class="desktop" aria-label="Principal">
      {navItems.map((n) => (
        <a href={n.href} class="rotulo" aria-current={n.id === current ? 'page' : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
    <div class="actions">
      <a class="play botao" href={`${config.paths.game}/`}>
        Jogar
      </a>
      <details class="mobile">
        <summary class="rotulo">
          <Icon name="menu" size={20} />
          Menu
        </summary>
        <nav aria-label="Principal (menu)">
          {navItems.map((n) => (
            <a
              href={n.href}
              class="body-strong"
              aria-current={n.id === current ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface-1);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 56px;
    padding: 0 var(--space-4);
    max-width: var(--layout-wide-max);
    margin: 0 auto;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch);
    color: var(--ink);
    text-decoration: none;
  }
  .mark :global(svg) {
    width: 28px;
    height: 28px;
    display: block;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .play {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--grass);
    color: var(--on-grass);
    text-decoration: none;
  }
  .play:hover {
    filter: brightness(1.08);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch);
    min-width: var(--touch);
    padding: 0 var(--space-3);
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    border-radius: var(--radius-pill);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .mobile > nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border-bottom: 1px solid var(--line);
    padding: var(--space-2) 0 var(--space-4);
  }
  .mobile > nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    color: var(--ink);
    text-decoration: none;
    border-left: 4px solid transparent;
  }
  .mobile > nav a:focus-visible {
    outline-offset: -2px;
  }
  .mobile > nav a[aria-current='page'] {
    border-left-color: var(--grass);
    font-weight: 600;
    background: var(--surface-2);
  }
  .desktop {
    display: none;
  }
  @media (min-width: 720px) {
    .mobile {
      display: none;
    }
    .desktop {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      flex: 1;
      gap: 0 var(--space-2);
    }
    .desktop a {
      display: inline-flex;
      align-items: center;
      min-height: var(--touch);
      padding: 0 var(--space-2);
      color: var(--ink-muted);
      text-decoration: none;
    }
    .desktop a:hover {
      color: var(--ink);
    }
    .desktop a[aria-current='page'] {
      color: var(--ink);
      font-weight: 600;
      box-shadow: inset 0 -3px 0 var(--grass);
    }
  }
</style>
