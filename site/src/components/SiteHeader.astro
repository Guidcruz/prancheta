---
import { config } from '../../../config/prancheta.config.ts';
import { navItems } from '../lib/nav';
import Icon from './Icon.astro';
import { GAME_PLAYABLE } from '../data/game';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const base = config.paths.site;
---

<header class="top">
  <div class="bar">
    <a class="brand" href={base}>
      {config.logo.hasBrand && <span class="mark" set:html={config.logo.mark} />}
      <span class="subtitulo">{config.name}</span>
    </a>
    <nav class="desktop" aria-label="Principal">
      {navItems.map((n) => (
        <a href={n.href} class="rotulo" aria-current={n.id === current ? 'page' : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
    <div class="actions">
      <a class="play botao" href={GAME_PLAYABLE ? `${config.paths.game}/` : `${base}devlog/`}>
        {GAME_PLAYABLE ? 'Jogar' : 'Acompanhar'}
      </a>
      <details class="mobile">
        <summary class="rotulo">
          <Icon name="menu" size={20} />
          Menu
        </summary>
        <nav aria-label="Principal (menu)">
          {navItems.map((n) => (
            <a
              href={n.href}
              class="body-strong"
              aria-current={n.id === current ? 'page' : undefined}
            >
              {n.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--surface-0) 78%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--glass-line);
  }
  /* No backdrop-filter support, or transparency reduced: opaque header. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .top {
      background: var(--surface-0);
      border-bottom-color: var(--line);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .top {
      background: var(--surface-0);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      border-bottom-color: var(--line);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 56px;
    padding: 0 var(--space-4);
    max-width: var(--layout-wide-max);
    margin: 0 auto;
  }
  @media (max-width: 359.98px) {
    .bar {
      padding: 0 var(--space-2);
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--touch);
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }
  .mark :global(svg) {
    width: 28px;
    height: 28px;
    display: block;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .play {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch);
    padding: 0 var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--grass);
    color: var(--on-grass);
    text-decoration: none;
    font: var(--type-botao);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  .play:hover {
    filter: brightness(1.08);
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: var(--touch);
    min-width: var(--touch);
    padding: 0 var(--space-3);
    cursor: pointer;
    list-style: none;
    color: var(--ink);
    border-radius: var(--radius-pill);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* The menu list is for reading: solid, never glass. */
  .mobile > nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border-bottom: 1px solid var(--line);
    padding: var(--space-2) 0 var(--space-4);
  }
  .mobile > nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    color: var(--ink);
    text-decoration: none;
    border-left: 4px solid transparent;
  }
  .mobile > nav a:focus-visible {
    outline-offset: -2px;
  }
  .mobile > nav a[aria-current='page'] {
    border-left-color: var(--grass);
    font-weight: 600;
    background: var(--surface-2);
  }
  .desktop {
    display: none;
  }
  @media (min-width: 840px) {
    .bar {
      padding: 0 var(--space-8);
    }
    .mobile {
      display: none;
    }
    .desktop {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 var(--space-2);
      margin-right: var(--space-3);
    }
    .desktop a {
      display: inline-flex;
      align-items: center;
      min-height: var(--touch);
      padding: 0 var(--space-2);
      color: var(--ink-muted);
      text-decoration: none;
    }
    .desktop a:hover {
      color: var(--ink);
    }
    .desktop a[aria-current='page'] {
      color: var(--ink);
      font-weight: 600;
      box-shadow: inset 0 -2px 0 var(--grass);
    }
  }
</style>
