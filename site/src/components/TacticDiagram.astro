---
interface Props {
  kind: 'formation' | 'posture' | 'pressure';
  title: string;
}
const { kind, title } = Astro.props;
// 433 as dots on a 100x64 pitch (own goal on the left).
const formation = [
  [8, 32],
  [24, 10],
  [24, 24],
  [24, 40],
  [24, 54],
  [48, 18],
  [48, 32],
  [48, 46],
  [72, 12],
  [74, 32],
  [72, 52],
];
---

<svg viewBox="0 0 100 64" role="img" aria-labelledby={`t-${kind}`}>
  <title id={`t-${kind}`}>{title}</title>
  <rect width="100" height="64" rx="3" fill="var(--pitch)" />
  <g fill="none" stroke="var(--pitch-line)" stroke-width="0.8">
    <rect x="2" y="2" width="96" height="60" />
    <line x1="50" y1="2" x2="50" y2="62" />
    <circle cx="50" cy="32" r="8" />
  </g>
  {kind === 'formation' &&
    formation.map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="var(--pitch-line)" />)}
  {kind === 'posture' && (
    <g stroke="var(--pitch-line)" stroke-width="2" fill="var(--pitch-line)">
      <line x1="14" y1="16" x2="78" y2="16" />
      <polygon points="86,16 78,12 78,20" stroke="none" />
      <line x1="14" y1="32" x2="62" y2="32" />
      <polygon points="70,32 62,28 62,36" stroke="none" />
      <line x1="14" y1="48" x2="42" y2="48" />
      <polygon points="50,48 42,44 42,52" stroke="none" />
    </g>
  )}
  {kind === 'pressure' && (
    <g>
      <rect x="2" y="2" width="32" height="60" fill="var(--pitch-line)" opacity="0.18" />
      <rect x="34" y="2" width="32" height="60" fill="var(--pitch-line)" opacity="0.38" />
      <rect x="66" y="2" width="32" height="60" fill="var(--pitch-line)" opacity="0.62" />
    </g>
  )}
</svg>
<style>
  svg {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
</style>
