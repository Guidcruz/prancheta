---
import { tower } from '../lib/stadium-geometry';
interface Props {
  side: 'left' | 'right';
}
const { side } = Astro.props;
const { plate, post } = tower;
---

<svg
  class:list={['tower', side]}
  viewBox={`0 0 ${tower.width} ${tower.height}`}
  aria-hidden="true"
  focusable="false"
>
  <rect
    x={plate.x}
    y={plate.y}
    width={plate.width}
    height={plate.height}
    rx={plate.rx}
    fill="var(--surface-2)"
    stroke="var(--line)"
    stroke-width="2"
  />
  {tower.lampYs.flatMap((cy) =>
    tower.lampXs.map((cx) => <circle {cx} {cy} r={tower.lampRadius} fill="var(--floodlight)" />),
  )}
  <rect x={post.x} y={post.y} width={post.width} height={post.height} fill="var(--line)" />
</svg>
<style>
  .tower {
    position: absolute;
    top: 8px;
    width: 64px;
    height: auto;
    z-index: -1;
    opacity: 0.9;
    pointer-events: none;
  }
  .left {
    left: -14px;
  }
  .right {
    right: -14px;
  }
  @media (min-width: 720px) {
    .tower {
      width: 120px;
    }
    .left {
      left: 24px;
    }
    .right {
      right: 24px;
    }
  }
</style>
