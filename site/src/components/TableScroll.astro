---
interface Props {
  label: string;
  minWidth?: string;
  /** Below 720px the state moves under the first cell (`.inline-state`) and `.col-state` goes away. */
  stack?: boolean;
}
const { label, minWidth = '520px', stack = false } = Astro.props;
---

<div
  class:list={['scroll', { stack }]}
  tabindex="0"
  role="region"
  aria-label={`${label} (tabela com rolagem)`}
  style={`--table-min: ${minWidth}`}
>
  <slot />
</div>
<style>
  /* Standings-table look: the container is the card, rows are 48px with a divider. */
  .scroll {
    overflow-x: auto;
    /* Scroll hint: edge shadows that show only where there is more to scroll to. */
    background:
      linear-gradient(to right, var(--surface-1), var(--surface-1)) left center / 16px 100% local
        no-repeat,
      linear-gradient(to left, var(--surface-1), var(--surface-1)) right center / 16px 100% local
        no-repeat,
      linear-gradient(to right, color-mix(in srgb, var(--ink) 16%, transparent), transparent) left
        center / 16px 100% scroll no-repeat,
      linear-gradient(to left, color-mix(in srgb, var(--ink) 16%, transparent), transparent) right
        center / 16px 100% scroll no-repeat,
      var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-2) 0;
    margin-bottom: var(--space-3);
  }
  .scroll :global(table) {
    min-width: var(--table-min);
  }
  .scroll :global(thead th) {
    border-bottom: 1px solid var(--line);
  }
  .scroll :global(tbody td),
  .scroll :global(tbody th) {
    height: 48px;
    vertical-align: middle;
  }
  .scroll :global(tbody tr:last-child > *) {
    border-bottom: 0;
  }
  /* Rows stay transparent so the edge shadows show; only the fixed column is opaque. */
  .scroll :global(tr > :first-child) {
    position: sticky;
    left: 0;
    background: var(--surface-1);
  }
  /* The fixed column casts its own edge shadow, so scrolling from the left reads as such. */
  .scroll :global(tr > :first-child::after) {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 6px;
    pointer-events: none;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--ink) 10%, transparent),
      transparent
    );
  }
  .scroll :global(tr[aria-current='step'] > :first-child) {
    background: var(--grass-soft);
  }
  .scroll :global(tr[aria-current='step']) {
    background: var(--grass-soft);
  }
  .scroll {
    container-type: inline-size;
  }
  .scroll :global(.inline-state) {
    display: none;
  }
  @media (max-width: 719.98px) {
    .stack :global(table) {
      min-width: 0;
    }
    .stack :global(.col-state) {
      display: none;
    }
    .stack :global(.inline-state) {
      display: block;
      margin-top: var(--space-1);
    }
    .stack :global(.inline-state .badge) {
      height: auto;
      min-height: 24px;
      padding-block: 2px;
      white-space: normal;
    }
    .stack :global(tr > :first-child) {
      width: 40%;
    }
  }
  .scroll :global(tbody th) {
    color: var(--ink);
    font: var(--type-body-strong);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
