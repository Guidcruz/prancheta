---
interface Props {
  label: string;
  minWidth?: string;
}
const { label, minWidth = '520px' } = Astro.props;
---

<div
  class="scroll"
  tabindex="0"
  role="region"
  aria-label={`${label} (tabela com rolagem)`}
  style={`--table-min: ${minWidth}`}
>
  <slot />
</div>
<style>
  /* Standings-table look: the container is the card, rows are 48px with a divider. */
  .scroll {
    overflow-x: auto;
    /* Scroll hint: edge shadows that show only where there is more to scroll to. */
    background:
      linear-gradient(to right, var(--surface-1), var(--surface-1)) left center / 16px 100% local
        no-repeat,
      linear-gradient(to left, var(--surface-1), var(--surface-1)) right center / 16px 100% local
        no-repeat,
      linear-gradient(to right, color-mix(in srgb, var(--ink) 16%, transparent), transparent) left
        center / 16px 100% scroll no-repeat,
      linear-gradient(to left, color-mix(in srgb, var(--ink) 16%, transparent), transparent) right
        center / 16px 100% scroll no-repeat,
      var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .scroll :global(table) {
    min-width: var(--table-min);
  }
  .scroll :global(thead th) {
    border-bottom: 1px solid var(--line);
  }
  .scroll :global(tbody td),
  .scroll :global(tbody th) {
    height: 48px;
    vertical-align: middle;
  }
  .scroll :global(tbody tr:last-child > *) {
    border-bottom: 0;
  }
  .scroll :global(tr) {
    background: var(--surface-1);
  }
  .scroll :global(tr > :first-child) {
    position: sticky;
    left: 0;
    background: inherit;
  }
  .scroll :global(tbody th) {
    color: var(--ink);
    font: var(--type-body-strong);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
