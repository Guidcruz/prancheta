---
interface Props {
  label: string;
  minWidth?: string;
}
const { label, minWidth = '520px' } = Astro.props;
---

<div
  class="scroll"
  tabindex="0"
  role="region"
  aria-label={`${label} (tabela com rolagem)`}
  style={`--table-min: ${minWidth}`}
>
  <slot />
</div>
<style>
  .scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-3);
  }
  .scroll :global(table) {
    min-width: var(--table-min);
  }
  .scroll :global(tr > :first-child) {
    position: sticky;
    left: 0;
    background: var(--surface-1);
    border-right: 1px solid var(--line);
  }
  .scroll :global(tbody th) {
    color: var(--ink);
    font: var(--type-body-strong);
    text-transform: none;
    letter-spacing: 0;
  }
</style>
