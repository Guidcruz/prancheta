---
import Button from './Button.astro';
import { config } from '../../../config/prancheta.config.ts';
interface Props {
  title?: string;
  primary?: { href: string; label: string };
  secondary?: { href: string; label: string };
}
const {
  title = 'Pronto para a prancheta?',
  primary = { href: `${config.paths.game}/`, label: `Abrir a versão atual (v${config.version})` },
  secondary = { href: `${config.paths.site}roadmap/`, label: 'Ver o roteiro' },
} = Astro.props;
---

<section class="cta" aria-labelledby="cta-title">
  <svg
    class="lines"
    viewBox="0 0 1000 400"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <g fill="none" stroke="currentColor" stroke-width="3">
      <path d="M500 0V400" />
      <circle cx="500" cy="200" r="120" />
      <rect x="-20" y="90" width="160" height="220" />
      <rect x="860" y="90" width="160" height="220" />
    </g>
  </svg>
  <h2 id="cta-title">{title}</h2>
  <p class="actions">
    <Button href={primary.href} glow>
      {primary.label}
    </Button>
    {secondary && (
      <Button href={secondary.href} variant="secondary">
        {secondary.label}
      </Button>
    )}
  </p>
</section>
<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
    padding: 64px var(--space-4) 72px;
    /* Night: a piece of pitch with the centre circle. */
    background: var(--pitch);
    color: var(--ink);
  }
  .lines {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    color: var(--pitch-line);
    opacity: 0.3;
  }
  h2 {
    margin: 0 0 var(--space-6);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    margin: 0;
  }
  .cta :global(a.secondary),
  .cta :global(a.secondary:hover) {
    background: var(--surface-0);
    border-color: transparent;
    color: var(--ink);
  }
  /* Day: soft green instead of a bright pitch, so the title keeps its contrast. */
  @media (prefers-color-scheme: light) {
    .cta {
      background: var(--grass-soft);
    }
    .lines {
      color: var(--grass);
      opacity: 0.35;
    }
  }
</style>
