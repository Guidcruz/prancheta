---
import type { SiteClub } from '../lib/shields';
import Sticker from './Sticker.astro';
interface Props {
  clubs: SiteClub[];
}
const { clubs } = Astro.props;
---

<ul class="grid">
  {clubs.map((club, i) => (
    <li>
      <Sticker {club} number={i + 1} grow />
    </li>
  ))}
</ul>
<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(128px, 1fr));
    justify-items: stretch;
    gap: var(--space-4);
  }
  li {
    display: flex;
    justify-content: center;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }
</style>
