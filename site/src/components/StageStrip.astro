---
import StatusBadge from './StatusBadge.astro';
import type { Stage } from '../lib/roadmap';
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;
---

<ol class="strip">
  {stages.map((s) => {
    const current = s.status === 'em-desenvolvimento';
    return (
      <li class:list={{ current }} aria-current={current ? 'step' : undefined}>
        <span class="numero id">{s.id}</span>
        <span class="name body-strong">{s.name}</span>
        <StatusBadge status={s.status} />
      </li>
    );
  })}
</ol>
<style>
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    min-height: var(--touch);
    padding: var(--space-2) var(--space-3);
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  li.current {
    border: 2px solid var(--grass);
    padding: calc(var(--space-2) - 1px) calc(var(--space-3) - 1px);
  }
  .id {
    min-width: 2ch;
  }
  .name {
    flex: 1;
  }
</style>
