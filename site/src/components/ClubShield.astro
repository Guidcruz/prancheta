---
// The only place of the site that draws a club shield. When the new shield generator
// replaces lib/generators/shield.ts, swap the import and the call below; nothing else changes.
import { shieldSpecFor, shieldSvg } from '../../../app/src/lib/generators/shield';
import type { SiteClub } from '../lib/shields';
interface Props {
  club: SiteClub;
  /** Width in px of the generated drawing; the box scales it with --shield-size. */
  size?: number;
  /** Decorative: hidden from assistive tech. Otherwise the shield gets "Escudo: {name}". */
  decorative?: boolean;
}
const { club, size = 96, decorative = false } = Astro.props;
// Generated at build time; no JavaScript reaches the browser.
const svg = shieldSvg(
  shieldSpecFor(club.id, club.colors[0], club.colors[1], club.abbreviation),
  size,
);
---

<span
  class="shield"
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : `Escudo: ${club.shortName}`}
  aria-hidden={decorative ? 'true' : undefined}
  style={`--shield-default: ${size}px`}
  set:html={svg}
/>
<style>
  .shield {
    display: block;
    width: var(--shield-size, var(--shield-default));
  }
  .shield :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
